[global]
    font = Melted Monster
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    frame_width = 2
    timeout = 5
    format = "<b>%s</b>\n<i>%b</i>"
    corner_radius = 10
    origin = top-right
    offset = 10x10

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 5

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0

[mi_estilo_dunstify]
    appname = "dunstify"
    format = "<b>%s</b>\n<i>%b</i>"
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 5000
